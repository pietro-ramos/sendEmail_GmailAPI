# Provedor principal: outlook, gmail ou smtp
PROVEDOR_ENVIO=outlook

# Arquivos do lote
EMAIL_INPUT_FILE=data/direct_lista_cartas.xlsx
EMAIL_PDF_DIR=data/cartas
EMAIL_REPORT_FILE=relatorio_bounces.xlsx
EMAIL_LOG_FILE=email_log.log
EMAIL_SUBJECT=AVISO AOS CREDORES - RECUPERAÇÃO JUDICIAL

# Outlook / Microsoft Graph
EMAIL_REMETENTE_OUTLOOK=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
OUTLOOK_RATE_LIMIT_PER_MINUTE=30
OUTLOOK_RETRIES=3
OUTLOOK_REQUEST_TIMEOUT_SECONDS=30

# Gmail API
EMAIL_REMETENTE_GMAIL=
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_RATE_LIMIT_PER_MINUTE=120
GMAIL_RETRIES=3
GMAIL_RETRY_DELAY_SECONDS=5

# SMTP genérico
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_REMETENTE_SMTP=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=60
SMTP_REQUIRE_AUTH=true
SMTP_RATE_LIMIT=40
SMTP_RATE_WINDOW_SECONDS=3600
SMTP_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=5

# Bounces: outlook ou gmail
BOUNCE_PROVIDER=outlook
BOUNCE_REPORT_FILE=relatorio_bounces.xlsx
BOUNCE_AFTER_DATE_OUTLOOK=2026-01-01
BOUNCE_AFTER_DATE_GMAIL=2026-01-01
BOUNCE_MAX_MESSAGES=3000
BOUNCE_PAGE_SIZE=300
BOUNCE_REQUEST_TIMEOUT_SECONDS=60
GMAIL_BOUNCE_CREDENTIALS_FILE=credentials.json
GMAIL_BOUNCE_TOKEN_FILE=token_bounces.json
